<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BluetoothAudioCodec.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Bluetooth Audio Codec"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarGrid" Padding="18,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon
                    FontSize="16"
                    Glyph="&#xE702;"
                    IsHitTestVisible="False" />
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    IsHitTestVisible="False"
                    Text="Bluetooth Audio Codec" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollMode="Auto"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="ScrollContentHost"
                Padding="32,26,32,32"
                HorizontalAlignment="Stretch">
                <StackPanel
                    MaxWidth="780"
                    HorizontalAlignment="Stretch"
                    Spacing="16">

                <Grid Margin="0,0,0,4" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="5">
                        <TextBlock
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Active Bluetooth codec" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Read the codec Windows negotiated with your headset."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        x:Name="StatusBadge"
                        Grid.Column="1"
                        Padding="10,5"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="14">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse
                                x:Name="StatusDot"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="StatusText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Ready" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="72"
                                Height="72"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                CornerRadius="36">
                                <FontIcon
                                    FontSize="28"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE702;" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock
                                    x:Name="CodecText"
                                    FontSize="40"
                                    FontWeight="SemiBold"
                                    MaxLines="1"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="ProtocolText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Bluetooth Classic · A2DP" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Symbol="Audio" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="DEFAULT OUTPUT" />
                                <TextBlock
                                    x:Name="DeviceText"
                                    FontWeight="SemiBold"
                                    Text="Checking…"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="A short quiet tone helps Windows create a fresh stream."
                        TextWrapping="Wrap" />

                    <Button
                        x:Name="DetectButton"
                        Grid.Column="1"
                        MinWidth="150"
                        Click="OnDetectClicked"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <ProgressRing
                                x:Name="DetectionProgress"
                                Width="16"
                                Height="16"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <FontIcon
                                x:Name="DetectIcon"
                                FontSize="14"
                                Glyph="&#xE721;" />
                            <TextBlock x:Name="DetectButtonText" Text="Detect codec" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar
                    x:Name="MessageBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational"
                    Title="Information" />

                <Expander Header="Technical details">
                    <Grid Padding="0,12,0,4" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="STANDARD ID" />
                            <TextBlock x:Name="StandardIdText" FontFamily="Cascadia Mono" Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="VENDOR ID" />
                            <TextBlock x:Name="VendorIdText" FontFamily="Cascadia Mono" Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="CODEC ID" />
                            <TextBlock x:Name="VendorCodecIdText" FontFamily="Cascadia Mono" Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="OBSERVED" />
                            <TextBlock x:Name="ObservedAtText" Text="—" />
                        </StackPanel>
                    </Grid>
                </Expander>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE946;" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="The A2DP event is emitted when a stream opens or closes. HFP calls and LE Audio use different codecs."
                        TextWrapping="Wrap" />
                </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
