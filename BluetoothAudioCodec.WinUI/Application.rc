#include <windows.h>
#include "NativeVersion.h"
IDI_APPLICATION ICON "Assets\\AppIcon.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION NATIVE_FILE_VERSION
 PRODUCTVERSION NATIVE_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Bluetooth Audio Codec Viewer\0"
   VALUE "ProductName", "Bluetooth Audio Codec Viewer\0"
   VALUE "FileVersion", NATIVE_VERSION_STRING
   VALUE "ProductVersion", NATIVE_VERSION_STRING
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
