    <value>LE Audio wird nicht unterstützt</value>
  </data>
  <data name="MessageLeAudioBody" xml:space="preserve">
    <value>Diese Ausgabe verwendet Bluetooth LE. Die A2DP-Codec-Erkennung unterstützt diesen Endpunkt nicht.</value>
  </data>
